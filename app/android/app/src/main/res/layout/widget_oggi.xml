<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/radice"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_sfondo"
    android:orientation="vertical"
    android:padding="14dp">
    <TextView android:id="@+id/titolo" android:layout_width="match_parent" android:layout_height="wrap_content" android:maxLines="1" android:ellipsize="end" android:text="Agenda" android:textColor="@color/widget_titolo" android:textSize="16sp" android:textStyle="bold" />
    <TextView android:id="@+id/sottotitolo" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="4dp" android:maxLines="1" android:text="" android:textColor="@color/widget_secondario" android:textSize="13sp" />
        <TextView android:id="@+id/riga1" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:maxLines="1" android:ellipsize="end" android:textColor="@color/widget_testo" android:textSize="14sp" android:visibility="gone" />
        <TextView android:id="@+id/riga2" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:maxLines="1" android:ellipsize="end" android:textColor="@color/widget_testo" android:textSize="14sp" android:visibility="gone" />
        <TextView android:id="@+id/riga3" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:maxLines="1" android:ellipsize="end" android:textColor="@color/widget_testo" android:textSize="14sp" android:visibility="gone" />
        <TextView android:id="@+id/riga4" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:maxLines="1" android:ellipsize="end" android:textColor="@color/widget_testo" android:textSize="14sp" android:visibility="gone" />
        <TextView android:id="@+id/riga5" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:maxLines="1" android:ellipsize="end" android:textColor="@color/widget_testo" android:textSize="14sp" android:visibility="gone" />
</LinearLayout>
